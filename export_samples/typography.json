            "$extensions": {
              "docs": {
                "reference": "https://getbootstrap.com/docs/5.3/content/typography/"
              },
              "platform": {
                "scssVariableName": "$font-size-base",
                "remValue": "1rem",
                "viewport": "all"
              }
            }
          },
          "sm": {
            "$value": 14,
            "$type": "number",
            "$description": "Small font size (0.875rem = 14px)",
