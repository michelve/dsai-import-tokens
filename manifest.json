{
  "name": "DSAi Token Manager v2",
  "id": "dsai-import-tokens-v2",
  "api": "1.0.0",
  "main": "code.js",
  "ui": "ui.html",
  "editorType": ["figma", "dev"],
  "documentAccess": "dynamic-page",
  "capabilities": ["inspect"],
  "networkAccess": {
    "allowedDomains": [
      "http://localhost:8947",
      "http://localhost:8000",
      "http://localhost:8080",
      "http://localhost:8888",
      "http://localhost:9000",
      "http://localhost:3000",
      "http://*.epikly.com",
      "https://*.epikly.com",
      "http://*.github.com",
      "https://*.github.com"
    ],
    "devAllowedDomains": [
      "http://localhost:8947",
      "http://localhost:8000",
      "http://localhost:8080",
      "http://localhost:8888",
      "http://localhost:9000",
      "http://localhost:3000"
    ],
    "reasoning": "Enable local HTTP server (localhost only) for remote IDE connections to fetch design tokens. Default port is 8947, with additional common development ports supported."
  },
  "menu": [
    {
      "name": "Import/Export Tokens",
      "command": "open-plugin",
      "parameterOnly": false
    },
    {
      "name": "Export Collection",
      "command": "export-collection",
      "parameters": [
        {
          "name": "Collection Name",
          "key": "collectionName",
          "allowFreeform": true
        }
      ],
      "parameterOnly": false
    },
    {
      "name": "Send to Server",
      "command": "send-to-server",
      "parameters": [
        {
          "name": "Collection Name",
          "key": "collectionName",
          "allowFreeform": true
        }
      ],
      "parameterOnly": false
    }
  ],
  "relaunchButtons": [
    {
      "command": "open-plugin",
      "name": "Import/Export Tokens"
    }
  ]
}