{
  "name": "DSAI Import Tokens",
  "id": "dsai-import-tokens",
  "api": "1.0.0",
  "main": "code.js",
  "ui": "ui.html",
  "editorType": ["figma", "dev"],
  "documentAccess": "dynamic-page",
  "capabilities": ["inspect"],
  "description": "Import and export design tokens in W3C format. Bidirectional sync between Figma Variables and JSON with full metadata preservation for the DSAI design system.",
  "documentationUrl": "https://github.com/michelve/dsai-import-tokens/blob/main/docs/QUICKSTART.md",
  "networkAccess": {
    "allowedDomains": [
      "localhost",
      "127.0.0.1",
      "*.local"
    ],
    "reasoning": "Enable local HTTP server (localhost only) for remote IDE connections to fetch design tokens"
  },
  "menu": [
    {
      "name": "Import/Export Tokens",
      "command": "open-plugin",
      "parameterOnly": false
    },
    {
      "name": "Export Collection",
      "command": "export-collection",
      "parameters": [
        {
          "name": "Collection Name",
          "key": "collectionName",
          "allowFreeform": true
        }
      ],
      "parameterOnly": false
    },
    {
      "name": "Send to Server",
      "command": "send-to-server",
      "parameters": [
        {
          "name": "Collection Name",
          "key": "collectionName",
          "allowFreeform": true
        }
      ],
      "parameterOnly": false
    }
  ],
  "relaunchButtons": [
    {
      "command": "open-plugin",
      "name": "Import/Export Tokens"
    }
  ]
}